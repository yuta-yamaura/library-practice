{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "moduleResolution": "Node",
        "strict": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "rootDir": "./prisma/generated",
        "outDir": "./prisma/generated",
        "declaration": false,
        "sourceMap": false
    },
    "include": [
        "prisma/generated/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}