{
  "name": "library-practice",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo check-types",
    "dev:admin": "turbo run dev --filter=@library-practice/admin",
    "dev:api": "turbo run dev --filter=@library-practice/api"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.7.2",
    "typescript": "5.9.2"
  },
  "pnpm": {
    "overrides": {
      "@prisma/dev>zeptomatch": "1.0.0"
    }
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}